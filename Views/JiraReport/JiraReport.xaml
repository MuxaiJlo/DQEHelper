<UserControl x:Class="DQEHelper.Views.JiraReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Padding="15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ПАНЕЛЬ НАСТРОЕК (Слева) -->
        <Border Grid.Column="0" Background="#FAFAFA" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="НАСТРОЙКИ ОТЧЕТА" FontWeight="Bold" FontSize="16" Foreground="#10288C" Margin="0,0,0,15"/>

                <TextBlock Text="Дата стрима (например, 2026_08_09):" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="StreamDateTextBox" Text="2026_08_09" Height="30" Margin="0,0,0,10" Padding="5,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Part Number (например, 9):" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="PartNumberTextBox" Text="9" Height="30" Margin="0,0,0,10" Padding="5,0" VerticalContentAlignment="Center"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Manual (шт):" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBox x:Name="ManualCountTextBox" Text="91" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Autotest (шт):" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBox x:Name="AutotestCountTextBox" Text="805" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Ссылка на таблицу (Spreadsheet):" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="SpreadsheetLinkTextBox" Height="30" Margin="0,0,0,15" Padding="5,0" VerticalContentAlignment="Center" Text="https://docs.google.com/..."/>

                <Button x:Name="SelectFileButton" Content="Сгенерировать отчет" Height="40" Background="#10288C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="SelectFileButton_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ПАНЕЛЬ РЕЗУЛЬТАТА (Справа) -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="15" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="ПРЕДПРОСМОТР MARKDOWN" FontWeight="Bold" FontSize="16" Foreground="#10288C" Margin="0,0,0,10"/>
                
                <TextBox x:Name="ReportOutputTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" 
                         Background="#F8F9FA" BorderBrush="#E0E0E0" Padding="10"/>

                <!-- Новая кнопка для сохранения в файл -->
                <Button x:Name="SaveMarkdownButton" Grid.Row="2" Content="Сохранить как .md файл" Height="40" Margin="0,15,0,0" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="SaveMarkdownButton_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
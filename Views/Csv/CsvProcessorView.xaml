<UserControl x:Class="DQEHelper.Views.Csv.CsvProcessorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Зона загрузки -->
            <RowDefinition Height="Auto" /> <!-- Настройки фильтрации -->
            <RowDefinition Height="*" />    <!-- Таблица с результатами -->
        </Grid.RowDefinitions>

        <!-- Зона Drag & Drop -->
        <Border Grid.Row="0" Margin="20,20,20,10" Height="100" CornerRadius="12" 
                BorderBrush="#10288C" BorderThickness="2" Background="#20FFFFFF"
                AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                           FontSize="32" Foreground="#10288C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="DropZoneText" Text="Перетащи сюда архив поставщиков (.csv)" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Настройки фильтрации -->
        <StackPanel Grid.Row="1" Margin="20,0,20,10">
            <TextBlock Text="Провайдеры для фильтрации (через запятую):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="ProviderInputTextBox" Grid.Column="0" Height="35" Padding="10,0" 
                         VerticalContentAlignment="Center" FontSize="14" 
                         ToolTip="Например: klook, agoda, Hotels In America"/>
                
                <Button x:Name="GenerateButton" Grid.Column="1" Margin="10,0,0,0" Width="150" 
                        Content="Сгенерировать Output" Background="#10288C" Foreground="White" 
                        FontWeight="Bold" Cursor="Hand" Click="GenerateButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Таблица данных (DataGrid) -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="2" Margin="20,10,20,20" 
                  AutoGenerateColumns="True" IsReadOnly="True" 
                  Background="Transparent" RowBackground="#FAFAFA" 
                  AlternatingRowBackground="#FFFFFF" HeadersVisibility="Column"
                  BorderBrush="#DDDDDD" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#10288C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>
        </DataGrid>
    </Grid>
</UserControl>
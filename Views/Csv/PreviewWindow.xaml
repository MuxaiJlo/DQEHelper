<Window x:Class="DQEHelper.Views.Csv.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Preview" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True" 
                  AutoGeneratingColumn="PreviewGrid_AutoGeneratingColumn"
                  AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column"/>
    </Grid>
</Window>
<UserControl x:Class="DQEHelper.Views.Coralogix.CoralogixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="Transparent">

    <!-- Трехпанельная архитектура -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" /> <!-- Зона поиска -->
            <ColumnDefinition Width="*" />   <!-- Зона предпросмотра -->
            <ColumnDefinition Width="280" /> <!-- Зона отчета (Корзина) -->
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- ПАНЕЛЬ 1: ПОИСК (ЛЕВАЯ КОЛОНКА)            -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#FAFAFA" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Фильтры -->
                    <RowDefinition Height="*" />    <!-- Результаты -->
                </Grid.RowDefinitions>

                <!-- Блок фильтров -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="ПОИСК СКАНОВ" FontWeight="Bold" FontSize="16" Foreground="#10288C" Margin="0,0,0,15"/>

                    <TextBlock Text="Customer Name:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox x:Name="CustomerTextBox" Text="agoda" Height="30" Margin="0,0,0,10" Padding="5,0" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Provider:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox x:Name="ProviderTextBox" Text="traveloka" Height="30" Margin="0,0,0,10" Padding="5,0" VerticalContentAlignment="Center"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Scan Method:" FontWeight="SemiBold" Foreground="#555"/>
                            <ComboBox x:Name="ScanMethodCombo" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="mobile_app"/>
                                <ComboBoxItem Content="web"/>
                                <ComboBoxItem Content="mobile_web"/>
                                <ComboBoxItem Content="Any"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Access Level:" FontWeight="SemiBold" Foreground="#555"/>
                            <ComboBox x:Name="AccessLevelCombo" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="public"/>
                                <ComboBoxItem Content="cug"/>
                                <ComboBoxItem Content="Any"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Stage:" FontWeight="SemiBold" Foreground="#555"/>
                    <ComboBox x:Name="StageCombo" Height="30" Margin="0,0,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="result processed"/>
                        <ComboBoxItem Content="result failed"/>
                        <ComboBoxItem Content="Any"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Availability:" FontWeight="SemiBold" Foreground="#555"/>
                            <ComboBox x:Name="AvailabilityCombo" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Available"/>
                                <ComboBoxItem Content="Not Available"/>
                                <ComboBoxItem Content="Any"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Limit:" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBox x:Name="LimitTextBox" Text="10" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="SearchButton" Content="Найти в Coralogix" Height="35" Background="#10288C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="SearchButton_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Список результатов поиска -->
                <GroupBox Grid.Row="1" Header="Результаты поиска" Margin="0,15,0,0" Foreground="#555" FontWeight="SemiBold">
                    <ListView x:Name="SearchResultsList" Margin="0,5,0,0" SelectionChanged="SearchResultsList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding ProviderScanId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="260"/>
                                    <TextBlock Text="{Binding TaskId}" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </GroupBox>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ПАНЕЛЬ 2: ПРЕДПРОСМОТР (ЦЕНТР)             -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="15" Margin="10,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ПРЕДПРОСМОТР JSON" FontWeight="Bold" FontSize="16" Foreground="#10288C" Margin="0,0,0,10"/>
                
                <TextBox x:Name="JsonPreviewTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                         FontFamily="Consolas" FontSize="13" Background="#F8F9FA" BorderBrush="#E0E0E0" Padding="10"/>

                <TextBlock x:Name="PreviewStatusText" Grid.Row="2" Text="Выберите скан из списка слева..." Foreground="#888" Margin="0,10,0,0" FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ПАНЕЛЬ 3: ОТЧЕТ / КОРЗИНА (ПРАВАЯ КОЛОНКА) -->
        <!-- ========================================== -->
        <Border Grid.Column="2" Background="#FAFAFA" CornerRadius="10" Padding="15" Margin="10,0,0,0" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="КОРЗИНА ОТЧЕТА" FontWeight="Bold" FontSize="16" Foreground="#10288C" Margin="0,0,0,15"/>

                <!-- Кнопка добавления в отчет -->
                <Button x:Name="AddToCartButton" Grid.Row="1" Content="Добавить выбранные (0)" Height="40" 
                        Background="#EAF6AD" Foreground="#10288C" FontWeight="Bold" Cursor="Hand" 
                        Click="AddToCartButton_Click" IsEnabled="False" Margin="0,0,0,15">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <!-- Список добавленных элементов -->
                <GroupBox Grid.Row="2" Header="Собрано для выгрузки" Foreground="#555" FontWeight="SemiBold">
                    <ListBox x:Name="CartListBox" Margin="0,5,0,0" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="&#xE8D3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ProviderScanId}" Width="190" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderScanId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!-- Кнопка финальной выгрузки -->
                <Button x:Name="ExportCsvButton" Grid.Row="3" Content="Выгрузить в CSV" Height="45" Margin="0,15,0,0" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="ExportCsvButton_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
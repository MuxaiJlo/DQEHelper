<Window x:Class="DQEHelper.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQEHelper"
        xmlns:views="clr-namespace:DQEHelper.Views.Csv"
        mc:Ignorable="d"
        Title="DQEHelper"
        Width="1050"
        Height="700"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#ffffff"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стили для кнопок в шапке (оставляем твои) -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5555" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- СТИЛЬ ДЛЯ КНОПОК МЕНЮ (RadioButton) -->
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
                <!-- Состояние активной вкладки -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="#EAF6AD"/> <!-- Акцентный цвет из градиента -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20">
        <!-- Главный фон -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10288C" Offset="0" />
                <GradientStop Color="#EAF6AD" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" /> <!-- Шапка -->
                <RowDefinition Height="*" />  <!-- Основная область -->
            </Grid.RowDefinitions>

            <!-- 1. TITLE BAR -->
            <Grid Grid.Row="0" Background="#33000000" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Иконка приложения (используем шрифт Segoe Fluent/MDL2) -->
                    <TextBlock Text="&#xE909;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="DQE Workspace" Foreground="White" FontSize="14" FontWeight="Bold" Opacity="0.95" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButton}">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. CONTENT AREA -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" /> <!-- Левая панель (Sidebar) -->
                    <ColumnDefinition Width="*" />   <!-- Рабочая область -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="#40000000">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Профиль -->
                            <RowDefinition Height="*"/>    <!-- Навигация -->
                            <RowDefinition Height="Auto"/> <!-- Настройки -->
                        </Grid.RowDefinitions>

                        <!-- Профиль пользователя -->
                        <Border Grid.Row="0" Margin="20,20,20,30" Padding="15" Background="#20FFFFFF" CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <!-- Аватарка (пока используем иконку) -->
                                <Border Width="40" Height="40" CornerRadius="20" Background="#10288C">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                               Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DQE Engineer" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Not authenticated" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Навигация (Рабочие процессы) -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="WORKFLOWS" Margin="20,0,0,10" FontSize="12" FontWeight="Bold" Opacity="0.5"/>
                            
                            <!-- Task 1: CSV -->
                            <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="MainMenu" IsChecked="True" x:Name="NavCsvProcessor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Width="30"/>
                                    <TextBlock Text="CSV Filter &amp; Check" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Task 2: API -->
                            <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="MainMenu" x:Name="NavApiFetcher">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Width="30"/>
                                    <TextBlock Text="Coralogix API" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Настройки (Внизу) -->
                        <Button Grid.Row="2" Margin="10,0,10,20" Height="45" Background="Transparent" BorderBrush="Transparent" Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Width="30"/>
                                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- РАБОЧАЯ ОБЛАСТЬ -->
                <Border Grid.Column="1" Margin="20" Background="#90FFFFFF" CornerRadius="12">
                    <ContentControl x:Name="MainContentArea">
                        <!-- Подставляем наш новый экран по умолчанию -->
                        <views:CsvProcessorView />
                    </ContentControl>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>